# Chatbot Configuration
NEXT_PUBLIC_SITE_URL=https://pokemon-emulator-tracker.vercel.app
GOOGLE_SITE_VERIFICATION=

CHAT_PROVIDER=ai-sdk
CHAT_MAX_TOKENS=-1
CHAT_TEMPERATURE=0
CHAT_THINKING=true
CHAT_ENABLE_TOOLS=true

OLLAMA_ENDPOINT=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:latest
OLLAMA_EMBEDDING_MODEL=embeddinggemma:latest
OLLAMA_API_KEY=
OLLAMA_ALLOW_RUNTIME_ENDPOINT=false

OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

AI_SDK_API_KEY=your_specific_model_api_key
AI_SDK_MODEL=anthropic/claude-sonnet-4-5
